# Ravelry API credentials: create a "basic auth: read only" app at
# https://www.ravelry.com/pro/developer and copy the generated pair here.
RAVELRY_API_USERNAME=
RAVELRY_API_PASSWORD=

# Personal-account app (basic auth: personal account) for endpoints that
# are not read-only methods: patterns/{id}/projects, patterns/{id}/comments,
# projects/{user}/{id}. Needed by scripts/fetch_mkal.py.
RAVELRY_PERSONAL_USERNAME=
RAVELRY_PERSONAL_API_KEY=
