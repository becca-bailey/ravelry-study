---
import Layout from "../layouts/Layout.astro";
import MkalParticipation from "../components/MkalParticipation";
import MkalOutcomes from "../components/MkalOutcomes";
---

<Layout
  title="Sixteen Mystery Knit-a-longs"
  palette="west"
  description="Sixteen years of Stephen West's Mystery Knit-Along in Ravelry data: who cast on, and who finished."
>
  <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12">
    <nav class="mb-6 text-sm"><a href="/" style="color: var(--muted)">← Ravelry data studies</a></nav>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight">Sixteen Mystery Knit-a-longs</h1>
      <div class="mt-3 h-1.5 w-24 rounded-full" style="background: var(--west-chartreuse)"></div>
      <p class="mt-2 max-w-2xl text-base" style="color: var(--muted)">
        Stephen West's annual Mystery Knit-Along, 2011 to 2026, as recorded in
        Ravelry projects: who cast on while the clues were dropping, and what
        became of their shawls. A data project by Becca Bailey.
      </p>
    </header>

    <MkalParticipation client:load />

    <div class="mt-16">
      <MkalOutcomes client:load />
    </div>
  </main>
</Layout>
