---
import Layout from "../layouts/Layout.astro";
import YarnBrandGrapher from "../components/YarnBrandGrapher";
import YarnBrandStream from "../components/YarnBrandStream";
import YarnBrandEras from "../components/YarnBrandEras";
---

<Layout
  title="Yarn brands over time"
  description="Which yarn brands Ravelry knitters chose, 2008 to 2025, measured on a panel of long-lived patterns."
>
  <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight">Yarn brands over time</h1>
      <div class="mt-3 h-1.5 w-24 rounded-full" style="background: var(--accent)"></div>
      <p class="mt-2 max-w-2xl text-base" style="color: var(--muted)">
        Which yarns knitters reached for, year by year, as recorded in the
        projects on 25 patterns that have been knit continuously since
        Ravelry's early days. A data project by Becca Bailey.
      </p>
    </header>

    <YarnBrandGrapher client:load />

    <div class="mt-16">
      <YarnBrandStream client:load />
    </div>

    <div class="mt-16">
      <YarnBrandEras client:load />
    </div>
  </main>
</Layout>
